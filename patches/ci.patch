+# =============================================================================
+# OASM + Rust + PyO3 + PowerShell Docker Environment
+# Multi-container development and production setup
+# =============================================================================
+
+services:
+  # ===========================================================================
+  # Rust Orchestrator - Primary coordination and HDF5 management
+  # ===========================================================================
+  rust-orchestrator:
+    build:
+      context: .
+      dockerfile: docker/rust.Dockerfile
+      target: development
+    container_name: oasm-rust-orchestrator
+    hostname: rust-orchestrator
+    volumes:
+      # Source code (read-write for development)
+      - ./src:/workspace/src:rw
+      - ./Cargo.toml:/workspace/Cargo.toml:rw
+      # Shared data volumes
+      - templates-data:/workspace/templates:rw
+      - logs-data:/workspace/logs:rw
+      - cbor-data:/workspace/data:rw
+      # Cargo cache for faster builds
+      - cargo-cache:/usr/local/cargo/registry
+      - cargo-git-cache:/usr/local/cargo/git
+    environment:
+      - RUST_LOG=debug
+      - RUST_BACKTRACE=1
+      - HDF5_DIR=/usr/lib/x86_64-linux-gnu/hdf5/serial
+      - OASM_ENV=development
+    ports:
+      - "8080:8080"  # Main API port
+      - "9090:9090"  # Metrics/observability
+    networks:
+      - oasm-internal
+    healthcheck:
+      test: ["CMD", "cargo", "--version"]
+      interval: 30s
+      timeout: 10s
+      retries: 3
+      start_period: 10s
+    restart: unless-stopped
+
+  # ===========================================================================
+  # Python PyO3 Pattern Testing Engine
+  # ===========================================================================
+  python-testing:
+    build:
+      context: .
+      dockerfile: docker/python.Dockerfile
+      target: development
+    container_name: oasm-python-testing
+    hostname: python-testing
+    depends_on:
+      - rust-orchestrator
+    volumes:
+      # Test code and Python source
+      - ./tests:/workspace/tests:rw
+      - ./src/python:/workspace/python:rw
+      - ./pytest.ini:/workspace/pytest.ini:ro
+      # Shared data (read-only templates, read-write data)
+      - templates-data:/workspace/templates:ro
+      - cbor-data:/workspace/data:rw
+      - logs-data:/workspace/logs:rw
+      # Pip cache
+      - pip-cache:/root/.cache/pip
+    environment:
+      - PYTHONUNBUFFERED=1
+      - PYTEST_TIMEOUT=300
+      - HYPOTHESIS_PROFILE=dev
+    networks:
+      - oasm-internal
+    command: ["pytest", "-v", "--cov", "--cov-report=html"]
+    restart: unless-stopped
+
+  # ===========================================================================
+  # PowerShell Minimal Core
+  # ===========================================================================
+  powershell-core:
+    image: mcr.microsoft.com/dotnet/sdk:8.0
+    container_name: oasm-powershell-core
+    hostname: powershell-core
+    volumes:
+      # PowerShell scripts (read-only from templates)
+      - templates-data:/workspace/templates:ro
+      - ./scripts:/workspace/scripts:ro
+      # Execution logs
+      - logs-data:/workspace/logs:rw
+    environment:
+      - DOTNET_CLI_TELEMETRY_OPTOUT=1
+      - POWERSHELL_TELEMETRY_OPTOUT=1
+    networks:
+      - oasm-internal
+    # Keep container running for exec commands
+    command: >
+      sh -c "
+      # Install PowerShell if not present
+      if ! command -v pwsh >/dev/null 2>&1; then
+        echo 'Installing PowerShell...';
+        apt-get update && apt-get install -y wget;
+        wget https://packages.microsoft.com/config/debian/11/packages-microsoft-prod.deb;
+        dpkg -i packages-microsoft-prod.deb;
+        apt-get update && apt-get install -y powershell;
+      fi;
+      # Keep container alive
+      while true; do sleep 3600; done
+      "
+    restart: unless-stopped
+
+  # ===========================================================================
+  # Optional: OASM Platform (if integrating existing OASM)
+  # ===========================================================================
+  oasm-db:
+    image: postgres:16-alpine
+    container_name: oasm-postgres
+    hostname: oasm-db
+    environment:
+      POSTGRES_DB: oasm
+      POSTGRES_USER: oasm
+      POSTGRES_PASSWORD: ${OASM_DB_PASSWORD:-oasm_dev_password}
+      POSTGRES_INITDB_ARGS: "-E UTF8 --locale=en_US.UTF-8"
+    volumes:
+      - oasm-db-data:/var/lib/postgresql/data
+    networks:
+      - oasm-internal
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U oasm"]
+      interval: 10s
+      timeout: 5s
+      retries: 5
+    restart: unless-stopped
+    profiles:
+      - with-oasm  # Only start if explicitly enabled
+
+  oasm-api:
+    image: node:20-bookworm-slim
+    container_name: oasm-api-server
+    hostname: oasm-api
+    depends_on:
+      oasm-db:
+        condition: service_healthy
+    working_dir: /app
+    volumes:
+      - ./oasm:/app:rw
+      - node-modules:/app/node_modules
+    environment:
+      DATABASE_URL: postgresql://oasm:${OASM_DB_PASSWORD:-oasm_dev_password}@oasm-db:5432/oasm
+      NODE_ENV: development
+      PORT: 3000
+    ports:
+      - "3000:3000"
+    networks:
+      - oasm-internal
+    command: >
+      sh -c "
+      if [ ! -d node_modules ]; then
+        npm install;
+      fi;
+      npm run dev
+      "
+    restart: unless-stopped
+    profiles:
+      - with-oasm  # Only start if explicitly enabled
+
+  # ===========================================================================
+  # Development Tools Container (optional)
+  # ===========================================================================
+  dev-tools:
+    image: alpine:latest
+    container_name: oasm-dev-tools
+    hostname: dev-tools
+    volumes:
+      - templates-data:/data/templates:rw
+      - logs-data:/data/logs:rw
+      - cbor-data:/data/cbor:rw
+    networks:
+      - oasm-internal
+    command: >
+      sh -c "
+      apk add --no-cache curl jq vim htop;
+      echo 'Development tools ready. Attach with: docker exec -it oasm-dev-tools sh';
+      tail -f /dev/null
+      "
+    restart: unless-stopped
+    profiles:
+      - dev-tools
+
+# =============================================================================
+# Networks
+# =============================================================================
+networks:
+  oasm-internal:
+    driver: bridge
+    ipam:
+      config:
+        - subnet: 10.100.0.0/16
+
+# =============================================================================
+# Volumes - Shared persistent data
+# =============================================================================
+volumes:
+  # HDF5 immutable templates
+  templates-data:
+    driver: local
+    driver_opts:
+      type: none
+      o: bind
+      device: ${PWD}/data/templates
+
+  # Audit logs
+  logs-data:
+    driver: local
+    driver_opts:
+      type: none
+      o: bind
+      device: ${PWD}/data/logs
+
+  # CBOR serialized data
+  cbor-data:
+    driver: local
+    driver_opts:
+      type: none
+      o: bind
+      device: ${PWD}/data/cbor
+
+  # Build caches
+  cargo-cache:
+  cargo-git-cache:
+  pip-cache:
+  node-modules:
+
+  # OASM database
+  oasm-db-data:
